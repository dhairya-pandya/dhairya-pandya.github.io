---
/**
 * The card grid used for writing: figure on top, tilt on hover
 * (transitions.dev 19-card-tilt, reduced to a 3D lean plus a
 * cursor-tracked glare). Shared between the /writing shelf and the
 * home page teaser so the two never drift into two different card
 * designs.
 */
interface Card {
  slug: string;
  title: string;
  blurb: string;
  visual: string;
  meta: string;
  /** An absolute URL routes off-site (e.g. Medium) instead of to /writing/[slug]. */
  href?: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    cards.map((card, i) => {
      const external = Boolean(card.href);
      return (
        <li class="reveal" style={`--enter-index:${i}`}>
          <a
            href={card.href ?? `/writing/${card.slug}`}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            class="t-tilt group block"
          >
            <div class="t-tilt-card overflow-hidden rounded-xl border border-line-2 bg-surface">
              <img
                src={card.visual}
                alt=""
                width="900"
                height="600"
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                class="block aspect-[9/5] w-full border-b border-line-2 bg-surface object-cover"
              />
              <div class="p-3.5">
                <p class="relative inline-flex items-center gap-1.5 text-ink">
                  <span class="link-draw-child relative">{card.title}</span>
                  {external && (
                    <svg viewBox="0 0 16 16" class="size-3 shrink-0 text-ink-4" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M6 4h6v6M12 4L4 12" />
                    </svg>
                  )}
                </p>
                <p class="mt-1 line-clamp-2 text-ink-3">{card.blurb}</p>
                <p class="numeric mt-2.5 text-label tracking-[0.04em] text-ink-4 uppercase">
                  {card.meta}
                </p>
              </div>
              <span class="t-tilt-glare" aria-hidden="true" />
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  /*
   * transitions.dev / 19-card-tilt. The pointer is tracked on the
   * flat outer wrapper, not the card that rotates: binding it to the
   * rotating element makes the edges slip under the cursor and the
   * hover flickers.
   */
  .t-tilt {
    perspective: 900px;
  }
  .t-tilt-card {
    position: relative;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition:
      transform var(--duration-moderate) var(--ease-out),
      border-color var(--motion-hover);
    will-change: transform;
  }
  .t-tilt:hover .t-tilt-card {
    border-color: var(--color-ink-4);
  }
  .t-tilt-glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-hover);
    background: radial-gradient(
      220px circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.09),
      transparent 65%
    );
  }
  .t-tilt:hover .t-tilt-glare {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-tilt-card {
      transform: none !important;
      transition: border-color var(--motion-hover);
    }
    .t-tilt-glare {
      display: none;
    }
  }
</style>

<script>
  const MAX = 5; /* degrees. Past about 6 the text starts to smear. */

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".t-tilt").forEach((wrap) => {
      const card = wrap.querySelector<HTMLElement>(".t-tilt-card");
      const glare = wrap.querySelector<HTMLElement>(".t-tilt-glare");
      if (!card) return;

      wrap.addEventListener("pointermove", (e) => {
        const r = wrap.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty("--ry", `${(px - 0.5) * 2 * MAX}deg`);
        card.style.setProperty("--rx", `${-(py - 0.5) * 2 * MAX}deg`);
        glare?.style.setProperty("--gx", `${px * 100}%`);
        glare?.style.setProperty("--gy", `${py * 100}%`);
      });

      wrap.addEventListener("pointerleave", () => {
        card.style.setProperty("--ry", "0deg");
        card.style.setProperty("--rx", "0deg");
      });
    });
  }
</script>
