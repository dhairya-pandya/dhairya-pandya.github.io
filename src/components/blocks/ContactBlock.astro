---
/**
 * The contact surface, shared by /contact and the footer.
 *
 * Built to the Figma spec (node 17:12927). The measurements that
 * carry the design and are easy to lose:
 *
 *   avatar        36px, 12px radius, 2px optical drop
 *   avatar gutter 36px + 12px gap = 48px
 *   bubbles       capped at 503px, NOT full width. They are speech,
 *                 and speech wants a shorter measure than a card.
 *   cards + pills indented by the full 48px gutter, so their left
 *                 edge lines up with the bubbles rather than with
 *                 the avatar. This is what makes the block read as
 *                 one conversation instead of two stacked regions.
 *   rhythm        20px head to bubbles, 36px bubbles to cards,
 *                 28px cards to pills
 *
 * One component on purpose: the footer teaser and the page are the
 * same conversation, so two copies would drift. `full` adds the
 * direct-line rows for the page.
 */
import { Icon } from "astro-icon/components";
import { site } from "../../config/site";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;

/* Prefilled, because a blank compose window is a small act of work
   handed to the person kind enough to get in touch. */
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(
  "Your portfolio"
)}&body=${encodeURIComponent(`Hi Dhairya,\n\n`)}`;

const askAbout = [
  "How to design an evaluation benchmark that actually stresses a model",
  "How to pick a refusal threshold without guessing",
  "What INT4 actually costs, with the histogram",
];

const connect = [
  { label: "LinkedIn", icon: "ph:linkedin-logo", url: "https://www.linkedin.com/in/dhairya-pandya/" },
  { label: "GitHub", icon: "ph:github-logo", url: "https://github.com/dhairya-pandya" },
];

const serverTime = new Intl.DateTimeFormat("en-GB", {
  timeZone: site.timezone,
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date());
---

<div class="contact-stack">
  {/* Speech: avatar in the gutter, bubbles in the content column. */}
  <div class="flex gap-3">
    <img
      src="/avatar.jpg"
      alt=""
      width="128"
      height="128"
      loading="lazy"
      decoding="async"
      class="mt-0.5 size-9 shrink-0 rounded-xl bg-raised object-cover"
    />
    <div class="min-w-0 flex-1">
      <p class="bubble bubble-first reveal">
        I read everything. Internships, questions about the write-ups, or
        telling me a number on this site is wrong.
      </p>
      <p class="bubble reveal mt-2" style="--enter-index:1">
        Fastest way to reach me is email. It is{" "}
        <span
          class="numeric text-ink"
          data-clock
          data-tz={site.timezone}
          data-seconds="false">{serverTime}</span
        > here right now, so allow for the timezone.
      </p>
    </div>
  </div>

  {/* Cards, indented to the bubbles' left edge. */}
  <div class="gutter mt-9 grid gap-4 sm:grid-cols-2">
    {/* The whole card is the mailto, so the target is the card and
        not one word inside it. */}
    <a href={mailto} class="reveal contact-card group" style="--enter-index:2">
      <span class="contact-head">
        <span class="label">Compose</span>
        <Icon
          name="ph:arrow-up-right"
          class="contact-arrow size-4 text-ink-3"
          aria-hidden="true"
        />
      </span>

      <span class="mt-3 block w-full">
        <span class="field"><span class="field-key">To</span><span class="field-value" title={site.email}>{site.email}</span></span>
        <span class="field mt-1.5"
          ><span class="field-key">Subj</span>Your portfolio</span
        >
        <span class="field mt-1.5"><span class="field-key">From</span>you</span>
      </span>

      <span class="mt-3 block text-ink-3">Hi Dhairya,</span>
      <span class="caret" aria-hidden="true"></span>

      {/* The block's one CTA, in the site's single emphasis shape. */}
      <span class="pill pill-solid mt-5 w-fit">
        <Icon name="ph:paper-plane-tilt" class="size-4" aria-hidden="true" />
        Compose this email
      </span>
    </a>

    {/* Three specifics beat an invitation. */}
    <div class="reveal contact-card" style="--enter-index:3">
      <span class="contact-head">
        <span class="label">Ask me about</span>
        <Icon name="ph:chats-circle" class="size-4 text-ink-3" aria-hidden="true" />
      </span>
      <ul class="bullets mt-3">
        {askAbout.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </div>

  {
    full && (
      <div class="gutter mt-4 grid gap-4 sm:grid-cols-2">
        {/* Page variant only: the footer teaser stays compact. Copy
            buttons rather than bare text, because the next step after
            reading an address is putting it somewhere. */}
        <div class="reveal contact-card" style="--enter-index:4">
          <span class="contact-head">
            <span class="label">Email</span>
            <Icon name="ph:envelope-simple" class="size-4 text-ink-3" aria-hidden="true" />
          </span>
          <p class="numeric mt-2 truncate text-ink" title={site.email}>{site.email}</p>
          <button type="button" data-copy-email={site.email} class="pill mt-4 w-fit">
            <Icon name="ph:copy" class="size-4" aria-hidden="true" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>
        <div class="reveal contact-card" style="--enter-index:5">
          <span class="contact-head">
            <span class="label">Phone</span>
            <Icon name="ph:phone" class="size-4 text-ink-3" aria-hidden="true" />
          </span>
          <p class="numeric mt-2 text-ink">{site.phone}</p>
          <a href="tel:+919173931925" class="pill mt-4 w-fit">
            <Icon name="ph:phone-call" class="size-4" aria-hidden="true" />
            Call
          </a>
        </div>
      </div>
    )
  }

  {/* Platform pills: hug their content, same gutter as the cards. */}
  <ul class="gutter mt-7 flex flex-wrap gap-2">
    {
      connect.map((c, i) => (
        <li class="reveal" style={`--enter-index:${(full ? 6 : 4) + i}`}>
          <a href={c.url} rel="me noopener" target="_blank" class="connect group">
            <Icon name={c.icon} class="size-4 shrink-0 text-ink-2" aria-hidden="true" />
            <span class="text-ink">{c.label}</span>
            <Icon
              name="ph:arrow-up-right"
              class="contact-arrow size-3.5 shrink-0 text-ink-4"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact-stack {
    width: 100%;
  }

  /*
   * The avatar gutter: 36px avatar + 12px gap. Cards and pills are
   * pushed by the whole thing so their left edge meets the bubbles'.
   * Below 40rem the indent goes: at that width it costs a fifth of
   * the screen and buys nothing.
   */
  .gutter {
    padding-left: 0;
  }
  @media (min-width: 40rem) {
    .gutter {
      padding-left: 3rem;
    }
  }

  /*
   * Speech. A surface with a hairline, not a filled grey blob: it
   * reads as an utterance from the radius and the stacking, which is
   * all the metaphor needs. Capped at 503px per the spec, because
   * speech wants a shorter measure than a card does.
   */
  .bubble {
    display: block;
    max-width: 503px;
    border: 1px solid var(--color-line-2);
    background-color: var(--color-surface);
    border-radius: var(--radius-bubble);
    padding: 0.625rem 0.875rem;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  /* Only the first bubble notches its top-left, the way a speech
     tail points back at the speaker. */
  .bubble-first {
    border-top-left-radius: 0.375rem;
  }

  .contact-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--color-line-2);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 1.125rem 1.25rem;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  a.contact-card:hover {
    border-color: var(--color-ink-4);
    background-color: var(--color-sunken);
  }
  /* Card and CTA are one control, so hovering anywhere lights both. */
  a.contact-card:hover :global(.pill-solid) {
    opacity: 0.88;
  }

  .contact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }
  .contact-arrow {
    transition: transform var(--motion-hover);
  }
  .group:hover .contact-arrow {
    transform: translate(2px, -2px);
  }

  .field {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    color: var(--color-ink-2);
  }
  .field-value {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .field-key {
    flex: none;
    inline-size: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-4);
  }

  /* A blinking caret after "Hi Dhairya," so the card reads as a
     message already partway written. */
  .caret {
    display: inline-block;
    width: 1px;
    height: 1.05em;
    margin-left: -0.35rem;
    vertical-align: text-bottom;
    background-color: var(--color-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .connect {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line-2);
    border-radius: 999px;
    padding: 0.4375rem 0.875rem;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  .connect:hover {
    border-color: var(--color-ink-4);
    background-color: var(--color-sunken);
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
