---
/**
 * Identity grid, from Figma 1:14923.
 *
 * A two-column list of icon plus value, all mono. It answers the
 * questions a reviewer asks in the first ten seconds (what, where,
 * how to reach) without spending a paragraph on any of them.
 *
 * The local-time row is the one that does real work: paired with
 * the offset from the viewer, it answers "can I call them now",
 * which no amount of prose does as well.
 */
import { Icon } from "astro-icon/components";
import { site, identity } from "../../config/site";

const serverTime = new Intl.DateTimeFormat("en-GB", {
  timeZone: site.timezone,
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
}).format(new Date());
---

<ul class="grid gap-x-8 gap-y-0 sm:grid-cols-2">
  {
    identity.map((row, i) => {
      const isClock = row.value === "__CLOCK__";
      return (
        <li
          class="reveal flex items-center gap-2.5 py-[7px]"
          style={`--enter-index:${i}`}
        >
          <span
            class="grid size-6 shrink-0 place-items-center rounded-md border border-line-2 text-ink-3"
            aria-hidden="true"
          >
            <Icon name={row.icon} class="size-3.5" />
          </span>

          {isClock ? (
            <span class="min-w-0 truncate font-mono text-body text-ink-2">
              <span
                class="numeric text-ink" data-clock
                data-tz={site.timezone}>{serverTime}</span
              >
              <span class="mx-1.5 text-ink-3" aria-hidden="true">//</span>
              <span data-tz-offset={site.timezone}>local time</span>
            </span>
          ) : row.href ? (
            <a
              href={row.href}
              class="link-ref min-w-0 truncate font-mono text-body"
            >
              {row.value}
            </a>
          ) : (
            <span
              class="min-w-0 truncate font-mono text-body text-ink-2"
              title={row.value}
            >
              {row.value}
            </span>
          )}
        </li>
      );
    })
  }
</ul>
