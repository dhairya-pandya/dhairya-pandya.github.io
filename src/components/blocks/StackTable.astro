---
/**
 * Stack table, from Figma 1:17937.
 *
 * Numbered rows with a hairline between each, the group name in the
 * left column and the tools as mono chips on the right. The number
 * is doing real work: it turns what would be a logo wall into an
 * ordered list, which implies the author ranked them.
 *
 * Grouped by the job each tool does rather than by language, so the
 * row labels answer "can he do X" instead of "what has he heard
 * of".
 */
import { stackGroups } from "../../config/site";
---

<dl class="rows border-t border-line-2">
  {
    stackGroups.map((group, i) => (
      <div
        class="reveal grid grid-cols-1 gap-x-6 gap-y-2 py-3.5 sm:grid-cols-[1fr_2.1fr]"
        style={`--enter-index:${i}`}
      >
        <dt class="flex items-baseline gap-2.5">
          <span class="numeric text-label text-ink-3">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="text-body text-ink">{group.group}</span>
        </dt>
        <dd>
          <ul class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="chip">
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>
