---
/**
 * A thin strip above the hero, held to the same centred column as
 * everything else on the page (the width the two vertical rules
 * mark), not full-bleed. Sky cropped off the top, boats kept in
 * frame via a low object-position.
 */
---

<div class="topbanner-band">
  <div class="topbanner column">
    <img
      src="/travel/banner-halong.jpg"
      alt="Cruise boats lit up at dusk among the limestone karsts of Ha Long Bay"
      width="2400"
      height="1349"
      loading="eager"
      decoding="async"
      class="topbanner-bg"
    />
    <p class="topbanner-quote">Not every good day shows up on a calendar.</p>
  </div>
</div>

<style>
  .topbanner-band {
    padding-block: 1.5rem 0;
  }
  .topbanner {
    position: relative;
    height: 13rem;
    overflow: hidden;
    border-radius: var(--radius-card);
  }
  @media (max-width: 40rem) {
    .topbanner {
      height: 10rem;
    }
  }

  .topbanner-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 78%;
  }

  .topbanner-quote {
    position: absolute;
    left: 1.25rem;
    bottom: 0.75rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background-color: rgb(8 8 10 / 0.72);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    color: rgb(255 255 255 / 0.92);
  }
</style>
