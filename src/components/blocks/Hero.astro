---
/**
 * Hero.
 *
 * Structure follows the reference you pointed at: avatar, name at a
 * modest size, role, two lines of bio, then a row of pills. The
 * previous version led with a 46px name over a large drawing, which
 * spent the whole first screen on saying who he is and none of it on
 * what he does.
 *
 * What is ours rather than borrowed: the mono tagline line and the
 * availability dot that only goes green while the copy says he is
 * looking. No backdrop drawing: the air is the backdrop.
 */
import { Icon } from "astro-icon/components";
import { site } from "../../config/site";
import FloatingCard from "./FloatingCard.astro";

---

<section class="band hero-band relative">
  <FloatingCard
    src="/travel/buddha.jpg"
    alt="A white Buddha statue wrapped in flowers, Marble Mountains"
    side="right"
    top="3rem"
    tilt={-3}
    width="5.5rem"
  />

  <div class="column">
    <div class="t-stagger">
      <div class="t-stagger-line t-stagger-line--1 flex items-center">
        <img
          src="/avatar.jpg"
          alt={site.name}
          width="112"
          height="112"
          class="avatar object-cover"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {/*
        The name is now the largest thing on the page rather than the
        fourth largest. text-wrap:balance so "Dhairya Pandya" breaks
        into two even lines at narrow widths instead of leaving one
        orphaned word under a long one.
      */}
      <h1
        class="t-stagger-line t-stagger-line--2 mt-5 text-display font-medium text-balance text-ink"
      >
        {site.name}
        {/*
          Pronunciation, revealed on demand. A name people mispronounce
          is a small real problem; the phonetic spelling is the honest
          fix, since a synthesised recording would not be his voice.

          text-body pins this to the scale's base step. Without it the
          button inherits --text-display and renders a 61px speaker
          icon beside the name. The -2px nudge that used to sit here
          was tuned against a 28px h1 and is wrong at every other size,
          so the alignment is optical now via align-middle.
        */}
        <button
          type="button" data-pronounce
          class="phon ml-2 inline-flex items-center gap-1.5 rounded-md px-1 align-middle text-body text-ink-3 transition-colors duration-fast ease-out hover:text-ink"
          aria-expanded="false"
          aria-label="How to pronounce this name"
        >
          <Icon name="ph:speaker-high" class="size-4" aria-hidden="true" />
          <span class="phon-text label normal-case">{site.pronounce}</span>
        </button>
      </h1>

      <p class="t-stagger-line t-stagger-line--3 mt-1 text-ink-2">
        {site.role}
        <span class="text-ink-3"> / </span>
        <span class="font-mono">{site.tagline}</span>
      </p>

      <p class="t-stagger-line t-stagger-line--4 prose-measure mt-3 text-ink-2">
        I build {site.builds}. Every project here states its baseline and the
        conditions under which it fails.
      </p>

      <p
        class="t-stagger-line t-stagger-line--4 mt-3 flex items-center gap-2 text-ink-2"
      >
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <div
        class="t-stagger-line t-stagger-line--5 mt-6 flex flex-wrap items-center gap-2.5"
        style="display: flex;"
      >
        {/* Resume is the primary action: for the audience this site is
            for, "show me the resume" is the job to be done, and email
            lives one click away on /contact and in the dock. */}
        <a href="/resume" class="pill pill-solid">
          <Icon name="ph:read-cv-logo" class="size-4" aria-hidden="true" />
          Resume
        </a>
        <a href="https://github.com/dhairya-pandya" rel="noopener" target="_blank" class="pill">
          <Icon name="ph:github-logo" class="size-4" aria-hidden="true" />
          GitHub
        </a>
        <button type="button" data-copy-email={site.email} class="pill">
          <Icon name="ph:copy" class="size-4" aria-hidden="true" />
          <span data-copy-label>Copy email</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero opens the page, so it gets air no other band gets:
     roughly double the section rhythm above, half again below. */
  /*
   * Top padding came down from 4.5/6.5rem to 2/3rem.
   *
   * The old value was tuned against a 28px name, where the block
   * needed air above it to read as deliberate rather than as content
   * that had slipped to the top of the page. At 61px the name supplies
   * that weight itself, and the same padding then stacked with the
   * 48px sticky bar and main's own 48px to put the focal point about
   * 200px down: a hierarchy problem dressed up as whitespace.
   */
  .hero-band {
    padding-block: 2rem 3rem;
  }
  @media (min-width: 40rem) {
    .hero-band {
      padding-block: 3rem 3.5rem;
    }
  }

  /* ---- avatar ------------------------------------------------
     One portrait, no monogram behind it. The paired-squircle idea
     came from the reference, but with a real photograph the second
     mark only competed with the face. */
  .avatar {
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 1.375rem;
    display: block;
    background-color: var(--color-raised);
  }

  /* ---- pronunciation ----------------------------------------- */
  .phon-text {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width var(--motion-disclose),
      opacity var(--motion-disclose);
  }
  .phon[aria-expanded="true"] .phon-text,
  .phon:hover .phon-text,
  .phon:focus-visible .phon-text {
    max-width: 16rem;
    opacity: 1;
  }

  /* ---- availability ------------------------------------------ */
  .status-dot {
    position: relative;
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 999px;
    background-color: var(--color-live);
  }
  /* The pulse is a bordered ring scaling out, not a spreading
     box-shadow: same signal, no shadow language, and transform +
     opacity stay on the compositor. The only looping animation on
     the site, well under the 3Hz flash threshold. */
  .status-dot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    border: 1px solid var(--color-live);
    animation: pulse 2.4s var(--ease-in-out) infinite;
  }
  @keyframes pulse {
    0% {
      opacity: 0.8;
      transform: scale(0.7);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  /* Toggle keeps the phonetic spelling open on touch, where there is
     no hover to hold it. */
  document.querySelectorAll<HTMLElement>("[data-pronounce]").forEach((b) => {
    b.addEventListener("click", () => {
      b.setAttribute(
        "aria-expanded",
        b.getAttribute("aria-expanded") === "true" ? "false" : "true"
      );
    });
  });
</script>
