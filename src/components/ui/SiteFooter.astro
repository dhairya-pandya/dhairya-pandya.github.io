---
/**
 * Footer: the contact teaser and the outline wordmark, nothing else.
 * The contact surface lives in ContactBlock, shared with /contact so
 * the two cannot drift; the footer renders the compact variant and
 * links the page for the rest.
 */
import ContactBlock from "../blocks/ContactBlock.astro";
---

<footer class="relative mt-12 border-t border-line-2">
  <div class="column py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 class="band-title">Get in touch</h2>
      <a
        href="/contact"
        class="label transition-colors duration-fast ease-out hover:text-ink"
      >
        Contact page &#8594;
      </a>
    </div>

    <div class="mt-5">
      <ContactBlock />
    </div>

  </div>

  {/*
    The outline wordmark. Clipped to half its height so it reads as a
    watermark rising out of the page edge rather than as a heading;
    stroked SVG rather than -webkit-text-stroke so it renders the
    same off Chromium.
  */}
  <div
    class="pointer-events-none overflow-hidden border-t border-line-2 select-none"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 1200 150"
      class="mark -mb-px block h-24 w-full sm:h-40"
      preserveAspectRatio="xMidYMax slice"
    >
      <text
        x="600"
        y="90"
        text-anchor="middle"
        font-family="Geist, system-ui, sans-serif"
        font-size="150"
        font-weight="600"
        letter-spacing="-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25">DHAIRYA</text
      >
    </svg>
  </div>
</footer>

<style>
  .mark {
    color: var(--color-line);
  }
</style>
