---
/**
 * Top bar. Two controls and a home link, spread across the full
 * viewport width rather than the content column: the bar frames the
 * page, so it hangs off the page's edges, not the column's.
 *
 * Right side: theme toggle (moved here from the dock, so both
 * "render for whom" controls live together) and the HUMAN/MACHINE
 * switch. The switch reads as a checkbox pair rather than a toggle
 * widget: it states the current fact ("[x] machine") instead of
 * making you interpret a knob position. Underneath it is a real
 * radio group, so arrow keys and screen readers come free.
 */
import { Icon } from "astro-icon/components";
import { site } from "../../config/site";
---

<header
  class="sticky top-0 z-30 h-12 border-b border-line-2 bg-ground/85 backdrop-blur-md"
  style="view-transition-name: topbar"
>
  <div class="flex h-full w-full items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="label shrink-0 transition-colors duration-fast ease-out hover:text-ink"
      aria-label={`${site.name}, home`}
    >
      {site.est}
    </a>

    <div class="flex shrink-0 items-center gap-4">
      <fieldset class="mode flex items-center gap-3" data-mode-switch>
        <legend class="sr-only">Render this page for</legend>

        <label class="mode-opt" data-mode-opt="human">
          <input type="radio" name="view-mode" value="human" checked />
          <span class="mode-box" aria-hidden="true"
            ><span class="mode-mark">x</span></span
          >
          <span class="mode-text">Human</span>
        </label>

        <label class="mode-opt" data-mode-opt="machine">
          <input type="radio" name="view-mode" value="machine" />
          <span class="mode-box" aria-hidden="true"
            ><span class="mode-mark">x</span></span
          >
          <span class="mode-text">Machine</span>
        </label>
      </fieldset>

      <span class="h-4 w-px bg-line" aria-hidden="true"></span>

      <button
        type="button"
        data-theme-toggle
        class="grid size-7 place-items-center rounded-md text-ink-3 transition-[color,transform] duration-moderate ease-out hover:rotate-12 hover:text-ink"
        aria-label="Toggle colour scheme"
      >
        <Icon name="ph:moon" class="size-4 theme-icon theme-icon--moon" aria-hidden="true" />
        <Icon name="ph:sun" class="size-4 theme-icon theme-icon--sun" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .mode {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .mode-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-3);
    transition: color var(--motion-hover);
  }
  .mode-opt:hover {
    color: var(--color-ink-2);
  }

  /* The native input is the control; visually replaced, never
     removed, so focus, keyboard and assistive tech keep working. */
  .mode-opt input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  /* Drawn as [ ] and [x] in the site's own mono, so the switch
     reads as part of the type system rather than a widget. */
  .mode-box {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    transition:
      border-color var(--motion-hover),
      background-color var(--motion-hover);
  }
  .mode-mark {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    color: var(--color-ground);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity var(--motion-hover),
      transform var(--motion-hover);
  }

  .mode-opt:has(input:checked) {
    color: var(--color-ink);
  }
  .mode-opt:has(input:checked) .mode-box {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .mode-opt:has(input:checked) .mode-mark {
    opacity: 1;
    transform: none;
  }

  .mode-opt:has(input:focus-visible) .mode-box {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Theme icon swap: two glyphs in one cell, cross-faded. The moon
     rests in light mode because the icon names the destination, not
     the state. System dark with no explicit choice shows the same
     state as explicit dark. */
  .theme-icon {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-moderate) var(--ease-in-out),
      transform var(--duration-moderate) var(--ease-in-out),
      filter var(--duration-moderate) var(--ease-in-out);
  }
  .theme-icon--sun {
    opacity: 0;
    transform: scale(0.7) rotate(-40deg);
    filter: blur(2px);
  }
  :global([data-theme="dark"]) .theme-icon--moon {
    opacity: 0;
    transform: scale(0.7) rotate(40deg);
    filter: blur(2px);
  }
  :global([data-theme="dark"]) .theme-icon--sun {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-icon--moon {
      opacity: 0;
      transform: scale(0.7) rotate(40deg);
      filter: blur(2px);
    }
    :global(html:not([data-theme="light"])) .theme-icon--sun {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  /* Below 26rem the two words stop fitting; the boxes carry it and
     the accessible names stay on the inputs. */
  @media (max-width: 26rem) {
    .mode-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .mode {
      gap: 0.5rem;
    }
  }
</style>
