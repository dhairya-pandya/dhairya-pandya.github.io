---
/**
 * Home.
 *
 * Section order follows the reference (Figma 1:14875) because the
 * order is the argument: identity, then verifiable activity, then
 * who he is, then the work, then the evidence around it. A reviewer
 * who leaves after two screens has still seen a name, a location, a
 * live clock and a year of commits.
 */
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Band from "../components/ui/Band.astro";
import Hero from "../components/blocks/Hero.astro";
import Heatmap from "../components/blocks/Heatmap.astro";
import AchievementBanner from "../components/blocks/AchievementBanner.astro";
import Greeting from "../components/blocks/Greeting.astro";
import ExperienceList from "../components/blocks/ExperienceList.astro";
import ProjectCards from "../components/blocks/ProjectCards.astro";
import StackTable from "../components/blocks/StackTable.astro";
import FannedStrip from "../components/blocks/FannedStrip.astro";
import FloatingCard from "../components/blocks/FloatingCard.astro";
import PostCards from "../components/blocks/PostCards.astro";
import { projects } from "../data/work";
import { machineHome } from "../lib/machine";

/* Featured first, then by recency. Four, not three: the cards sit in a
   two-column grid, so an odd count leaves the last one alone beside a
   hole. Four fills two rows exactly, and a short list a reviewer will
   actually read still beats a complete one they scroll past. */
const featured = [...projects]
  .sort((a, b) => Number(b.featured) - Number(a.featured) || b.start.localeCompare(a.start))
  .slice(0, 4);

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .filter((p) => p.data.status === "live")
  .slice(0, 2);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" })
    .format(d)
    .replace(/\//g, ".");

/* The Medium piece is pinned first: longest write-up on the site,
   just not one Astro renders. */
const postCards = [
  {
    slug: "four-breakpoints-fine-tuning-gemma-4-e2b",
    title: "Four Breakpoints: Fine-Tuning Gemma 4 E2B",
    blurb:
      "The four walls we hit building PathOS under Gemma 4 Good Hackathon constraints: a memory ceiling, a refusal-hedging habit, a 55-point dev-to-deployment gap, and an edge device with no GPU.",
    visual: "/mock/cover-breakpoints.svg",
    meta: "29.08.2026 / 17 min / Medium",
    href: "https://medium.com/@dhairyapandya2006/four-breakpoints-fine-tuning-gemma-4-e2b-0380d8aed3b5",
  },
  ...posts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    blurb: p.data.description,
    visual: p.data.cover,
    meta: `${fmt(p.data.date)} / ${p.data.readingTime}`,
  })),
];

const notes = [
  {
    src: "/notes/note-htf.jpg",
    alt: "Team CureCode at Hack the Future, heads down at the table",
    note: "Hack The Future, MoSPI & IIT Gandhinagar",
  },
  {
    src: "/notes/note-hackbyte.jpg",
    alt: "Team getalife() taking 2nd prize at Hackbyte 4.0, IIITDM Jabalpur",
    note: "Hackbyte 4.0 — victory moment",
  },
  {
    src: "/notes/note-hackbit.jpg",
    alt: "After the Hackbyte 4.0 ceremony, prizes still in hand",
    note: "HackBit — Best Use of Gemini",
  },
  {
    src: "/notes/note-hackbyte-floor.jpg",
    alt: "Deep into the overnight hackathon floor at Hackbyte 4.0, mid build",
    note: "Hackbyte 4.0 — surviving the judging rounds at 3 AM",
  },
];

/* MACHINE view of this page, built from the same objects the
   human view below renders. See lib/machine.ts. */
const machineDoc = machineHome(
  posts.map((p) => ({ title: p.data.title, description: p.data.description, slug: p.id }))
);
---

<PageLayout machine={machineDoc} section="home">
  <Hero />

  <Band>
    <Heatmap fig={1} />
  </Band>

  <Band>
    <AchievementBanner />
  </Band>

  <Band>
    <Greeting />
    <FloatingCard
      src="/travel/pagoda.jpg"
      alt="A lit pagoda under the evening moon"
      side="right"
      top="2.75rem"
      tilt={-4}
    />
  </Band>

  <Band
    id="experience"
    title="Experience"
    note="Two places, one of them a leaderboard. Expand a row for what actually changed."
  >
    <ExperienceList />
  </Band>

  <Band
    id="work"
    title="Selected systems"
    count={projects.length}
    note={`Every entry states its baseline and the conditions under which it fails. ${featured.length} of ${projects.length} shown.`}
    action={{ label: "All systems", href: "/work" }}
  >
    <ProjectCards items={featured} />
    <a slot="footer" href="/work" class="pill">
      See all {projects.length} systems
      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </a>
  </Band>

  {/* Field notes. The one non-instrument block: a small stack of
      prints, deliberately physical against an otherwise ruled page. */}
  <Band id="notes" title="Hackathons" note="Snapshots from the floor, the stage, and the 3 AM judging rounds.">
    <FannedStrip
      items={notes}
      caption="Four events, four teams, one habit of showing up."
    />
  </Band>

  <Band
    id="writing"
    title="Writing"
    note="Mostly about measurement, and about the ways a good number can be a lie."
    action={{ label: "All writing", href: "/writing" }}
  >
    <PostCards cards={postCards} />
  </Band>

  <Band id="stack" title="Stack" note="Grouped by the job, not by the language.">
    <StackTable />
  </Band>
</PageLayout>
