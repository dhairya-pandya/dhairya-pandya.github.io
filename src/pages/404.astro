---
/**
 * 404.
 *
 * The reference's block library includes "Not Found 01, a 404 page
 * with a playable brick breaker game" (Figma 1:17498). A game is
 * the wrong answer on a portfolio: someone landing here followed a
 * broken link and wants the thing they came for, not a toy.
 *
 * So this keeps the reference's instinct (a 404 should be a real
 * page, not an apology) and spends it on navigation instead: the
 * routes that exist, and the palette shortcut.
 */
import { Icon } from "astro-icon/components";
import PageLayout from "../layouts/PageLayout.astro";
import { dockItems } from "../config/site";
import { projects } from "../data/work";
import { machineNotFound } from "../lib/machine";

/* MACHINE view of this page, built from the same objects the
   human view below renders. See lib/machine.ts. */
const machineDoc = machineNotFound();
---

<PageLayout machine={machineDoc} title="Not found" description="That page does not exist." footer={false}>
  <section class="band">
    <div class="column">
      <p class="label label-quiet">Error 404</p>
      <h1
        class="mt-3 text-display font-medium text-ink"
      >
        That page does not exist.
      </h1>
      <p class="prose-measure mt-3 text-body">
        Either the link was wrong or something moved. Here is everything that is
        actually here.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a href="/" class="pill pill-solid">
          <Icon name="ph:house" class="size-4" aria-hidden="true" />
          Home
        </a>
        <button type="button" data-palette-open class="pill">
          <Icon name="ph:magnifying-glass" class="size-4" aria-hidden="true" />
          Search everything
        </button>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="column">
      <p class="label label-quiet">Pages</p>
      <ul class="rows mt-2 border-t border-line-2">
        {
          dockItems.map((d) => (
            <li>
              <a
                href={d.href}
                class="row-interactive group flex items-center gap-3 py-2.5"
              >
                <span
                  class="grid size-7 shrink-0 place-items-center rounded-md border border-line-2 text-ink-3"
                  aria-hidden="true"
                >
                  <Icon name={d.icon} class="size-4" />
                </span>
                <span class="link-draw-child relative text-body text-ink">
                  {d.label}
                </span>
                <span class="numeric ml-auto text-label text-ink-3">
                  {d.href}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="label label-quiet mt-7">Systems</p>
      <ul class="rows mt-2 border-t border-line-2">
        {
          projects.map((p) => (
            <li>
              <a
                href={`/work/${p.slug}`}
                class="row-interactive group flex items-center gap-3 py-2.5"
              >
                <span
                  class="grid size-7 shrink-0 place-items-center rounded-md border border-line-2 text-ink-3"
                  aria-hidden="true"
                >
                  <Icon name={p.icon} class="size-4" />
                </span>
                <span class="link-draw-child relative text-body text-ink">
                  {p.title}
                </span>
                <span class="numeric ml-auto text-label text-ink-3">
                  {p.maturity}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>
