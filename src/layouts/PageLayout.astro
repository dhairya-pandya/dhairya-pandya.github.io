---
/**
 * The page frame.
 *
 * Three things live here and nowhere else: the document head, the
 * drawing grid (.sheet + .sheet-rules), and the two chrome surfaces
 * (the mode bar at the top, the dock at the bottom).
 *
 * The grid is the structural device taken from the Figma reference:
 * the content column's edges are drawn as hairlines running the full
 * document height, so the page reads as a measured drawing rather
 * than a stack of cards.
 *
 * MACHINE view: every page passes a markdown serialisation of itself
 * via `machine`. The switch flips data-mode on <html>; CSS swaps
 * which of the two subtrees is visible. Both are always in the DOM,
 * so the toggle costs no request and cannot half-load.
 */
import "../styles/global.css";
import { site, profiles } from "../config/site";
import TopBar from "../components/ui/TopBar.astro";
import Dock from "../components/ui/Dock.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import Palette from "../components/ui/Palette.astro";
import MachineView from "../components/ui/MachineView.astro";
import Loader from "../components/ui/Loader.astro";
import Analytics from "../components/ui/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  /** Marks the active dock entry. */
  section?: "home" | "work" | "writing" | "contact" | "resume";
  footer?: boolean;
  /**
   * Keeps a page out of the index. robots.txt here is allow-all on
   * purpose, and sitemap.xml is an explicit allowlist, so a route that
   * should not be found needs to say so in its own head. Used by
   * /playground: internal design review, not portfolio surface.
   */
  noindex?: boolean;
  /** Markdown serialisation of this page, for the MACHINE view. */
  machine: string;
}

const {
  title = `${site.name}, ${site.role}`,
  description = `${site.role}. I build ${site.builds}`,
  section = "home",
  footer = true,
  noindex = false,
  machine,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/*
 * PNG, not SVG. X, LinkedIn, Slack, WhatsApp, Facebook and iMessage
 * all refuse an SVG og:image, so the previous /mock/og.svg meant every
 * share of this site rendered with no image at all. Absolute URL is
 * also mandatory: relative og:image is ignored by most crawlers.
 */
const ogImage = new URL("/og.png", Astro.site ?? site.url).href;

/*
 * JSON-LD Person. Worth the bytes on a portfolio specifically: it is
 * how a search engine (and increasingly an agent) learns that the name,
 * the job title and the profile links belong to one entity rather than
 * being loose strings on a page. sameAs is the part that does the
 * linking, so it is built from the same profiles array the pages render.
 */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: `${site.role}. I build ${site.builds}.`,
  url: (Astro.site ?? new URL(site.url)).href,
  image: new URL("/avatar.jpg", Astro.site ?? site.url).href,
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  sameAs: profiles.map((p) => p.url),
  knowsAbout: [
    "Machine learning",
    "Model evaluation",
    "Retrieval",
    "Quantization",
    "Signal processing",
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-mode="human">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex && (
        <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
      )
    }

    {/* Icons. The SVG is for browsers that take one; the 32px PNG and
        the .ico cover the rest, and apple-touch-icon is what iOS uses
        when a visitor adds the site to their home screen. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Mobile browser chrome follows the page, in both schemes. */}
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f7f7f5"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#131316"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}, ${site.role}. ${site.tagline}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    {/*
      Geist and Geist Mono. The reference file declares its own
      typeface in its colophon ("TYPEFACE  Geist"). Astro's site
      pairs Obviously + Inter + MDIO, all three commercially
      licensed, so none of them are shippable from here.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Loaded non-blocking: the stylesheet arrives at lowest priority
      (media="print"), then promotes itself once fetched. First paint
      happens in the fallback stack instead of waiting on a third
      party, and display=swap makes the arrival a reflow rather than
      a blank page. The noscript copy keeps fonts for no-JS visitors.

      Weight ranges are trimmed to what the site actually uses:
      400-600 sans, 400-500 mono. Every axis unit past that is bytes
      for glyphs no rule ever asks for.
    */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap"
      />
    </noscript>

    <script is:inline>
      /*
        Restore both preferences before first paint, or a returning
        visitor sees a flash of the wrong theme and the wrong mode.

        Theme is SYSTEM FIRST: with nothing stored, no attribute is
        set and the prefers-color-scheme media query in theme.css
        decides. Both stored values have to be applied here, because
        each one is overriding a system default that could go either
        way.
      */
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") {
          document.documentElement.dataset.theme = t;
        }
        if (localStorage.getItem("mode") === "machine") {
          document.documentElement.dataset.mode = "machine";
        }
        /*
          The loader is a front-door moment, not a toll booth. Marking
          it here, before paint, means internal navigation never even
          flashes the overlay.
        */
        if (sessionStorage.getItem("seen-loader")) {
          document.documentElement.dataset.loaded = "true";
        }
      } catch {}
      /*
        Marks that scripting is available. Every "starts hidden,
        animates in" rule is gated on .js, so if this never runs the
        content is simply visible rather than stuck at opacity 0.
      */
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="bg-ground text-ink-2 font-sans antialiased">
    <Loader />

    <a href="#main" class="skip-link">Skip to content</a>

    <TopBar />

    {/* HUMAN view */}
    <div class="sheet" data-view="human">
      <div class="sheet-rules" aria-hidden="true"></div>
      <main id="main" class="relative pt-12 pb-32">
        <slot />
        {footer && <SiteFooter />}
      </main>
    </div>

    {/* MACHINE view */}
    <MachineView content={machine} />

    <Dock section={section} />
    <Palette />

    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>

    <Analytics />
  </body>
</html>
