{
  "name": "holdout",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "gen:assets": "node scripts/gen-mock.mjs",
    "gen:pdf": "node scripts/gen-resume-pdf.mjs",
    "gen": "node scripts/gen-mock.mjs && node scripts/gen-icons.mjs && node scripts/gen-resume-pdf.mjs",
    "prebuild": "npm run gen",
    "check": "astro check",
    "dev:backend": "astro build && wrangler dev",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.81",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/ph": "^1.2.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4"
  },
  "description": "An evidence-first portfolio for AI engineers. Astro + Tailwind, with an agent-readable twin of every page.",
  "license": "MIT"
}
